$accentColor = #0b9e9a
$textColor = #0e1520
$borderColor = #c8d3e2
$codeBgColor = #1a2230

.navbar
  background-color rgba(247, 249, 252, 0.92)
  -webkit-backdrop-filter blur(14px) saturate(1.2)
  backdrop-filter blur(14px) saturate(1.2)
  border-bottom 1px solid rgba(200, 211, 226, 0.65)
  box-shadow none

.navbar .site-name
  font-weight 700
  letter-spacing -0.02em
  color #0e1520

.nav-links
  a
    font-weight 600
    font-size 0.92rem
  .router-link-active
    color $accentColor

/* dropdown — cleaner panel */
.nav-links .dropdown-wrapper
  .dropdown-title
    font-weight 600
  .nav-dropdown
    min-width 168px
    padding 0.45rem 0
    border 1px solid #c8d3e2
    border-radius 12px
    background #fff
    box-shadow 0 16px 36px -20px rgba(14, 21, 32, 0.35)
    margin-top 0.35rem
    .dropdown-item > a
      padding 0.55rem 1.15rem
      font-weight 500
      color #3a4556
      &:hover
        color $accentColor
        background rgba(11, 158, 154, 0.08)
      &.router-link-active
        color $accentColor
        font-weight 650
        &::after
          border-left-color $accentColor

/* homepage: softer top bar */
html.hh-page .navbar
  background-color rgba(232, 238, 245, 0.78)
  border-bottom-color transparent
